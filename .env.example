# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Required for live AI analysis. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (must be a stable model that supports JSON output + images)
GEMINI_MODEL=gemini-3.6-flash

# Optional: server port for `npm start` (defaults to 8787)
PORT=8787

# Optional: max AI requests per client IP in a 10-minute window (defaults to 30)
RATE_LIMIT_MAX=30
